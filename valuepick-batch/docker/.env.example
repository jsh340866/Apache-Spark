# docker-compose.yml 실행 전 이 파일을 .env로 복사하고 값을 채울 것
# .env는 .gitignore에 등록되어 커밋되지 않음

MYSQL_ROOT_PASSWORD=changeme

# jobs/01_ingest_raw.py 실행에 필요 (기존 ValuePick과 동일한 발급 키 사용 가능)
# 같은 키를 프로덕션과 공유하는 경우 --limit 옵션으로 종목 수를 제한해 호출량을 관리할 것 (DART 일일 10,000콜 제한)
DART_API_KEY=changeme
STOCK_API_KEY=changeme

# 03_build_indicators.py에서 외화(CNY 등) 표시 재무제표를 KRW로 환산할 때 필요
EXIM_API_KEY=changeme
